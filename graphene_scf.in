
&CONTROL
  calculation = 'scf',
  prefix      = 'graphene',
  outdir      = './temp',
  pseudo_dir  = './',
  tstress     = . true .
  tprnfor     = . true .

/

&SYSTEM
  ibrav     = 4,
  celldm (1)      = 4.6608373919
  celldm (3)      = 8.1089553887
  nat  = 2,
  ntyp = 1,
  nbnd            = 8
  ecutwfc = 120.0,
  ecutrho = 400.0,
  occupations = 'smearing',
  smearing = 'mv',
  degauss = 0.01,
  assume_isolated = '2D'
  nosym           = . true .
  noinv           = . true .

/

&ELECTRONS
  conv_thr = 1.0d-8

/

&CELL
!  cell_dofree = '2Dxy'         ! Restricts relaxation to the flat plane only
/

ATOMIC_SPECIES
  C  12.0107 C.upf

ATOMIC_POSITIONS alat
  C 0.3333333333 0.6666666667 0.5000000000
  C 0.6666666667 0.3333333333 0.5000000000

K_POINTS automatic
  60 60 1   0 0 0
